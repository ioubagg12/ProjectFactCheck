# Voice Fact Checker Configuration Example
# Copy this file to .env and fill in your actual credentials

# Google Fact Check Tools API Key
FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# Groq API Key (for LLM fact-checking and query reformulation)
GROQ_API_KEY=your_groq_api_key_here

# Serper Search API Key (for live web search in online mode)
SERPER_API_KEY=your_serper_api_key_here

# Google Custom Search Engine CX ID (optional, if using Custom Search)
GOOGLE_SEARCH_CX=your_google_search_cx_here

# Global Hotkey (default: f8)
HOTKEY=f8

# Application Mode: online or offline
APP_MODE=online

# Vosk Speech-to-Text Model Path
VOSK_MODEL_PATH=model
